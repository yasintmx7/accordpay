# Public Arc Testnet settings used by the browser bundle.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Add the address printed by the deployment command, then restart Next.js.
NEXT_PUBLIC_ACCORDPAY_ADDRESS=
# Circle Modular Wallets. Match the passkey domain in Circle Console to this site.
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_MODULAR_WALLET_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# CPN is disabled until Circle grants enterprise/sandbox access.
NEXT_PUBLIC_CPN_ENABLED=false
CPN_API_KEY=
CPN_WEBHOOK_PUBLIC_KEY=

# Server-side deployment settings. Never expose this key with NEXT_PUBLIC_.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_DEPLOYER_PRIVATE_KEY=
