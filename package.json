{
  "name": "accordpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test",
    "contract:clean": "hardhat clean",
    "deploy:arc": "hardhat ignition deploy ignition/modules/AccordPay.ts --network arcTestnet --parameters ignition/parameters/arcTestnet.json",
    "arc:check": "node --import tsx scripts/check-arc.ts",
    "check": "npm run lint && npm run typecheck && npm run contract:test && npm run build"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.14.1",
    "@circle-fin/bridge-kit": "^1.12.2",
    "@circle-fin/modular-wallets-core": "^1.0.15",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/chai": "^5.2.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "hardhat": "^3.11.1",
    "solc": "0.8.24",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "type": "module"
}
